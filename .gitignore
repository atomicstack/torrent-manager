# build artefacts
/dist/
/bin/
/seedctl
/tmgr
/tmweb

# secrets, certs (NEVER commit private keys)
/certs/*
!/certs/.gitignore

# local sensitive data (rutorrent state with tracker passkeys, etc.)
/private/

# editor crud
.DS_Store
*.swp
.vscode/
.idea/
*.log

# go test detritus
*.test
*.out
coverage.*
